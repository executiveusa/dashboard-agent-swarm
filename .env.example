# DAR Studio Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# API & Backend
# ============================================
VITE_API_BASE_URL=http://localhost:8787
DATABASE_URL=postgresql://dashboard:changeme@localhost:5432/dashboard
REDIS_URL=redis://localhost:6379/0

# ============================================
# LLM Providers
# ============================================

# LiteLLM Gateway (optional - routes all LLM calls through unified API)
VITE_LITELLM_BASE_URL=

# OpenAI
VITE_OPENAI_API_KEY=
OPENAI_API_KEY=

# Anthropic
VITE_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=

# Google Gemini (for design, images, cheap tasks)
VITE_GEMINI_API_KEY=

# Local LLM (optional - for privacy/cost)
VITE_LOCAL_LLM_URL=http://localhost:8000

# Legacy AI providers
GROQ_API_KEY=
AZURE_OPENAI_API_KEY=
VLM_API_KEY=

# ============================================
# Integrations
# ============================================

# Stripe (for payments & donations)
VITE_STRIPE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Firecrawl (for competitor research & content generation)
VITE_FIRECRAWL_API_KEY=

# WhatsApp Business API (for LATAM agent)
VITE_WHATSAPP_API_BASE_URL=https://graph.facebook.com/v18.0
VITE_WHATSAPP_API_TOKEN=
VITE_WHATSAPP_BUSINESS_NUMBER=

# n8n Automation (hosted on Hostinger)
AGENT_LIGHTNING_ENABLED=true
AGENT_LIGHTNING_ENV=prod

# ============================================
# Multi-Tenant & White-Label
# ============================================

# Default org ID for development
VITE_DEFAULT_ORG_ID=

# App branding
VITE_APP_NAME=DAR Studio

# ============================================
# Security
# ============================================

# JWT Secret for auth
JWT_SECRET=change-me

# CORS allowed origins
CORS_ORIGINS=http://localhost:8082,http://localhost:8080,https://yourdomain.com

# Supabase (optional legacy integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Development
# ============================================
VITE_PORT=5174

# ============================================
# Feature Flags
# ============================================

# Enable experimental features
VITE_ENABLE_WHATSAPP_AGENT=true
VITE_ENABLE_AFFILIATE_SYSTEM=true
VITE_ENABLE_CONTENT_ENGINE=true
VITE_ENABLE_PRODUCT_FACTORY=true
