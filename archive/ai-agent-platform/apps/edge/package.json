{
  "name": "apps/edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' --config ../../configs/eslint.config.mjs",
    "test": "vitest run",
    "dev": "vitest watch --run",
    "deploy": "echo 'Deploy via Lovable CLI: lovable deploy --project edge'",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@ai-agent-platform/shared": "workspace:^",
    "cron-parser": "5.10.1",
    "js-yaml": "5.4.2",
    "node-fetch": "3.3.2",
    "p-limit": "7.3.2",
    "playwright-core": "1.63.0",
    "uuid": "14.0.2",
    "zod": "4.6.5",
    "adm-zip": "0.6.1"
  },
  "devDependencies": {
    "@types/node-fetch": "3.0.3"
  }
}