{
  "name": "apps/edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' --config ../../configs/eslint.config.mjs",
    "test": "vitest run",
    "dev": "vitest watch --run",
    "deploy": "echo 'Deploy via Lovable CLI: lovable deploy --project edge'",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@ai-agent-platform/shared": "workspace:^",
    "cron-parser": "4.9.0",
    "js-yaml": "4.3.2",
    "node-fetch": "3.3.2",
    "p-limit": "4.0.0",
    "playwright-core": "1.42.1",
    "uuid": "9.0.1",
    "zod": "3.22.4",
    "adm-zip": "0.5.10"
  },
  "devDependencies": {
    "@types/node-fetch": "3.0.3"
  }
}