{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:compile": "tsc -p tsconfig.desktop.json",
    "desktop:serve": "cross-env-shell \"NODE_ENV=development TS_NODE_PROJECT=tsconfig.desktop.json wait-on tcp:5173 && electron -r ts-node/register/transpile-only ./desktop/main.ts\"",
    "desktop:dev": "concurrently -k \"npm:dev\" \"npm:desktop:serve\"",
    "desktop:build": "npm run build && npm run desktop:compile",
    "desktop:package:win": "npm run desktop:build && electron-builder --win",
    "test": "echo \"Test suite not yet configured\"",
    "ralphy:init": "ralphy --init",
    "ralphy:config": "ralphy --config",
    "ralphy:loop": "ralphy --copilot --prd PRD.md --max-retries 3 --retry-delay 5",
    "provision": "node scripts/provision.mjs",
    "docker:up": "docker-compose up --build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
