# Frontend configuration
VITE_API_BASE_URL="http://localhost:4000"
VITE_FLOWISE_PROXY_PATH="/agents"
VITE_APP_NAME="Dashboard Agent Swarm"

# Database and queue (docker-compose defaults)
POSTGRES_DB="dashboard"
POSTGRES_USER="dashboard"
POSTGRES_PASSWORD="changeme"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"
REDIS_URL="redis://localhost:6379/0"

# Flowise runtime
FLOWISE_PORT=3000
FLOWISE_DATA_DIR="./data/flowise"
VITE_PORT=5174

# AI model credentials (override as needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
AZURE_OPENAI_API_KEY=
VLM_API_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Auth (to be wired to edge service)
JWT_SECRET="change-me"

# Supabase (optional legacy integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
